GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.5-flash-lite
# Ordem de tentativa quando um modelo atinge cota, rate limit ou fica indisponível.
# Use os identificadores exibidos para o seu projeto no Google AI Studio.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash
# Uma única chamada de IA por material; limite a quantidade de conceitos retornados.
EXTRACTION_MAX_CONCEPTS=12
PORT=3333
# Supabase: Connect > Session pooler (porta 5432), recomendado para uma VM OCI IPv4.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_POOL_MAX=3
MATERIAL_STORAGE_PATH=/app/data/materials
EXTRACTION_CONCURRENCY=1

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=