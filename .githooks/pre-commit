#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! git diff --quiet || [[ -n "$(git ls-files --others --exclude-standard)" ]]; then
  echo 'Stage all working-tree changes before committing so local CI checks the exact commit content.' >&2
  exit 1
fi

./scripts/ci-local.sh
