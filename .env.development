# Configuração pública de desenvolvimento. Segredos, como GEMINI_API_KEY, ficam em .env.
NODE_ENV=development
PORT=3333
POSTGRES_DB=masterme_dev
POSTGRES_USER=masterme_dev
POSTGRES_HOST_AUTH_METHOD=trust
POSTGRES_PORT=5432
DEV_DATABASE_URL=postgresql://masterme_dev@db:5432/masterme_dev
TEST_POSTGRES_DB=masterme_test
TEST_POSTGRES_USER=masterme_test
TEST_POSTGRES_PORT=5433
MIGRATION_TEST_DATABASE_URL=postgresql://masterme_test@127.0.0.1:5433/masterme_test
MIGRATION_TEST_REQUIRED=true
PUBLIC_APP_URL=http://localhost:3000
DATABASE_POOL_MAX=3
MATERIAL_STORAGE_PATH=/app/data/materials
MODEL_NAME=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash
EXTRACTION_MAX_CONCEPTS=12
EXTRACTION_CONCURRENCY=1
AI_DAILY_REQUEST_LIMIT=100
AI_CREDITS_ENABLED=true
AI_GLOBAL_DAILY_CREDIT_LIMIT=500
INFINITEPAY_TIMEOUT_MS=5000
OBSERVABILITY_DB_TIMEOUT_MS=1000
