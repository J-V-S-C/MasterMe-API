GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.5-flash-lite
# Ordem de tentativa quando um modelo atinge cota, rate limit ou fica indisponível.
# Use os identificadores exibidos para o seu projeto no Google AI Studio.
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash,gemini-3.6-flash
# Uma única chamada de IA por material; limite a quantidade de conceitos retornados.
EXTRACTION_MAX_CONCEPTS=12
PORT=3333
DATABASE_URL=postgresql://socratic:socratic@localhost:5432/socratic_game
MATERIAL_STORAGE_PATH=/app/data/materials
EXTRACTION_CONCURRENCY=3
