{
  "name": "masterme-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "start": "bun server.ts",
    "generate": "DATABASE_URL=postgresql://localhost:5432/masterme prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "validate": "bun run generate && bun run typecheck && bun test",
    "validate:dependencies": "bun audit --production",
    "validate:guardrails": "bun test scripts/quality-guardrails.test.ts",
    "migrate": "bun migrate.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/server": "^1.9.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mdast-util-from-markdown": "^2.1.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "saxes": "6.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "7.10.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
